# WorkLens backend — environment reference
#
# Copy to backend/.env for local work. This file is committed; backend/.env is not.
# NO REAL VALUE EVER GOES IN THIS FILE. Deployed values come from Terraform outputs and
# are set as Lambda environment variables; the one genuine secret (the device root key)
# lives in Secrets Manager and is never an environment variable at all.
#
# After `terraform apply`, `make env-backend` prints these with the real values filled in
# from the Terraform outputs, so you can redirect it into backend/.env.
#
# Two different consumers read from here, and it matters which:
#
#   - The Lambdas validate their environment through src/shared/config.ts at module load. Every
#     name below except the two marked MIGRATION CLI ONLY is one that file reads. A name it does
#     not read is silently ignored, which is worse than an error — an earlier version of this file
#     used seven names the code had since renamed, so a deployer could set
#     S3_PRESIGN_VIEW_TTL_SECONDS to shorten a screenshot URL's life and change nothing at all.
#     scripts/check-env.sh now fails the build when this file and config.ts disagree.
#   - scripts/migrate.ts reads backend/.env directly, and needs DB_MIGRATOR_USER — the Lambdas
#     never run migrations, so config.ts has no such key.

# --- Runtime -----------------------------------------------------------------

# Names the deployment in every log line. Any non-empty string; defaults to prod.
ENVIRONMENT=prod

# --- AWS ---------------------------------------------------------------------

# Region the stack is deployed in. ap-south-1 (Mumbai) is the default because India's
# DPDP Act is the target jurisdiction and keeping the data in-country is the easiest
# position to defend.
AWS_REGION=ap-south-1

# --- Database ----------------------------------------------------------------

# RDS instance endpoint, without the port. Terraform output: rds_endpoint
DB_HOST=localhost

DB_PORT=5432

# Terraform output: rds_db_name
DB_NAME=worklens

# The role the Lambdas actually connect as. REQUIRED — config.ts has no default for it, so a
# deployed function with this unset fails at module load rather than falling back to something.
DB_USER=worklens_app

# The same role, named for the Terraform output that supplies it. Kept because `make env-backend`
# emits it and modules/lambda passes it as DB_USER; they must agree.
DB_APP_USER=worklens_app

# MIGRATION CLI ONLY (scripts/migrate.ts). Role migrations run as. Must be the RDS master user on
# first run, because migration 0003 grants rds_iam and only rds_superuser can do that. The Lambdas
# never run migrations, so config.ts does not read this.
DB_MIGRATOR_USER=postgres

# 1 to authenticate with an RDS IAM token, 0 to use DB_PASSWORD. Defaults to 1, which is why
# DB_PASSWORD is empty below: with IAM auth there is no database password anywhere in the stack.
DB_IAM_AUTH=1

# Leave EMPTY for the deployed stack: with no password set, connections use RDS IAM
# authentication, which signs a short-lived token locally. Set it only for a local
# Postgres container, where IAM auth does not exist.
DB_PASSWORD=

# disable | require | verify-full
# Defaults to verify-full, flatly — not host-dependent, which an earlier version of this comment
# claimed. Set it to disable for a local Postgres container, which has no certificate to verify.
DB_SSL_MODE=verify-full

# MIGRATION CLI ONLY (scripts/migrate.ts). Path to the RDS CA bundle, used when
# DB_SSL_MODE=verify-full. LEAVE IT EMPTY: the bundle is committed at
# backend/assets/rds-ca-global-bundle.pem and migrate.ts falls back to it. Pointing this at a path
# that does not exist makes verify-full fail closed with a confusing "no CA bundle" error, which is
# exactly what an earlier `make env-backend` produced.
DB_SSL_CA_PATH=

# ARN of the Secrets Manager secret holding the RDS master credentials. Only the db-migrate
# function needs it: the application role cannot bootstrap its own privileges, so migrations run as
# the master user. Terraform output: rds_master_secret_arn
DB_MASTER_SECRET_ARN=

# Maximum pooled connections per Lambda container. Keep this at 1: RDS db.t4g.micro
# allows roughly 85 connections, and a warm fleet of containers each holding several
# would exhaust that long before the CPU became the limit. Raise it only behind RDS Proxy.
DB_POOL_MAX=1

# --- Device credentials ------------------------------------------------------

# ARN of the Secrets Manager secret holding the device root key. Device secrets are
# DERIVED from this per device (docs/PLAN.md deviation D4), so no device secret is ever
# stored in the database. Terraform output: device_root_key_secret_arn
DEVICE_ROOT_KEY_SECRET_ARN=

# Accepted clock skew, in seconds, for HMAC-signed agent requests. A request whose
# X-WL-Timestamp falls outside ±this window is rejected. Must stay well below the nonce
# sweep interval in migration 0002, or replays become possible at the window boundary. Bounds:
# 30-900. Config validation refuses a NONCE_RETENTION_SECONDS that is not greater than this,
# because a nonce forgotten sooner than a timestamp expires reopens the replay window.
HMAC_TIMESTAMP_SKEW_SECONDS=300

# How long a used nonce is remembered, in seconds. Bounds: 600-86400. Must exceed
# HMAC_TIMESTAMP_SKEW_SECONDS — see above.
NONCE_RETENTION_SECONDS=600

# Per-device ingest quota: events accepted per rolling window. Generous relative to a
# 60-second sample interval, so it only ever catches a malfunctioning or hostile agent.
DEVICE_QUOTA_EVENTS_PER_WINDOW=5000
DEVICE_QUOTA_WINDOW_SECONDS=3600

# Maximum events in a single ingest batch, and maximum request body size in bytes.
MAX_EVENTS_PER_BATCH=500
INGEST_MAX_BODY_BYTES=1048576

# --- Screenshots -------------------------------------------------------------

# Terraform output: s3_screenshot_bucket
SCREENSHOT_BUCKET=

# KMS key the bucket encrypts with. Presigned PUTs are pinned to this key, so a URL
# cannot be used to write an unencrypted object.
S3_KMS_KEY_ARN=

# Lifetime of a presigned upload URL, in seconds. Short on purpose: the agent requests one
# immediately before uploading, so it never needs to hold a valid URL for long.
PRESIGN_EXPIRY_SECONDS=900

# Lifetime of a presigned *view* URL issued to the dashboard. Shorter still, because these
# grant a human read access to a screenshot of someone's screen.
PRESIGN_VIEW_EXPIRY_SECONDS=300

# Largest screenshot the presign endpoint will authorise, in bytes. Enforced in the
# presigned URL's Content-Length condition, not just checked in the handler. Bounds: 1024 bytes to
# 20 MiB.
MAX_SCREENSHOT_BYTES=5242880

# Key prefix screenshot objects are written under. Trailing slash included.
SCREENSHOT_PREFIX=screenshots/

# --- Cognito -----------------------------------------------------------------

# Terraform outputs: cognito_pool_id, cognito_client_id
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Aggregation -------------------------------------------------------------

# How many days back a scheduled aggregation run recomputes. More than one, because an
# agent that was offline overnight uploads yesterday's events today, and that late data
# has to land in the right day's timesheet.
AGGREGATION_LOOKBACK_DAYS=3

# Ceiling on regex evaluation for project title rules, in milliseconds per event, so a
# pathological pattern cannot stall the aggregation job.
AGGREGATION_REGEX_BUDGET_MS=5

# --- Logging -----------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 to include request bodies in logs. Off by default and must stay off in
# production: request bodies contain window titles, which are personal data.
LOG_REQUEST_BODIES=0
