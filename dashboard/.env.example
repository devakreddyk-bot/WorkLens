# WorkLens dashboard — environment reference
#
# Copy to dashboard/.env.local. That file is gitignored; this one is committed and contains no real
# values. After `terraform apply`, generate it from the stack's outputs:
#
#   make env-dashboard > dashboard/.env.local
#
# Nothing here is a secret. The Cognito app client uses the authorisation-code flow with PKCE and has
# no client secret, which is why there is none to keep out of the browser bundle.

# The API root, including the stage. Terraform output: api_base_url
NEXT_PUBLIC_API_BASE_URL=https://abc123.execute-api.ap-south-1.amazonaws.com/v1

# The Cognito hosted-UI domain that serves the sign-in page. Terraform output: cognito_hosted_ui_domain
NEXT_PUBLIC_COGNITO_DOMAIN=https://worklens-prod-a1b2c3d4.auth.ap-south-1.amazoncognito.com

# Terraform output: cognito_client_id
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Where this dashboard is served from. Must be one of the origins in the Terraform variable
# `dashboard_origins`, and `<this>/api/auth/callback` must be a registered Cognito callback URL —
# Cognito matches the redirect URI exactly, so a trailing slash difference is a failed login.
NEXT_PUBLIC_APP_URL=http://localhost:3000

